# 
# 1. decide which files with input data should be read in:
#
--finp=hdf5; ../testdata/c6h6/grid_3d.h5; labels=[/result/grid/points/coor_1, /result/grid/points/coor_2, /result/grid/points/coor_3]
--finp=hdf5; ../testdata/c6h6/jBz.h5; labels=[/result/grid_function/j/visualize/values/t1_icomp_3]
#
# 2. dataset corresponding to grid points
#
--grid=[/result/grid/points/coor_1, /result/grid/points/coor_2, /result/grid/points/coor_3]
#
# 3. dataset corresponding to a tensor:
#
--form_tensor_0order_3d=[/result/grid_function/j/visualize/values/t1_icomp_3]
#
# 4. use TTK to (i) "resample to image" and generate vti
#
--calc_from_tensor_0order_3d=generate_vti
--resampled_dim=33,35,17
#
# 5. decide what output you need:
#
--fout=csv; data.csv; cols=[x, y, z, t0:jzBz]
--fout=vti; data.vti; cols=[x, y, z, t0:jzBz]
--fout_select=all
--flog=result_log.txt
