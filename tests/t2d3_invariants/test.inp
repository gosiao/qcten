# 
# 1. decide which files with input data should be read in:
#
--finp=csv; ../testdata/lih_jbtensor_cubegrid10/data.csv; cols=[x, y, z, bx_jx, bx_jy, bx_jz, by_jx, by_jy, by_jz, bz_jx, bz_jy, bz_jz]; sep= ; skip=1
#
# 2. decide which columns correspond to grid points and which - to data
#
#    order of grid points coordinates:
#       x, y, z
--grid=[x, y, z]
#
# 3. decide which data 'makes a tensor':
#     * the names of tensor elements must match the names of (selected) columns on input files read in point 1 (with --finp). 
#     * the order of tensor elements matters! see below:
#
#                                       order of tensor elements:
#                         xx      xy     xz     yx     yy    yz     zx      zy     zz
--form_tensor_2order_3d=[bx_jx, by_jx, bz_jx, bx_jy, by_jy, bz_jy, bx_jz, by_jz, bz_jz]
#
# 4. decide what you want to calculate for this tensor:
#
--calc_from_tensor_2order_3d=invariant1
--calc_from_tensor_2order_3d=invariant2
--calc_from_tensor_2order_3d=invariant3
--resampled_dim=10,10,10
#
# 5. decide what output you need:
#
--fout=csv; invariants.csv; cols=[x, y, z, t2d3_invariant1, t2d3_invariant2, t2d3_invariant3]
--fout=vti; invariants.vti; cols=[x, y, z, t2d3_invariant1, t2d3_invariant2, t2d3_invariant3]
--fout_select=all
--flog=result_log.txt
