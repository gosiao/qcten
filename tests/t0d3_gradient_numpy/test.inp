# 
# 1. files with input data:
#
--finp=hdf5; ../testdata/c6h6/grid_3d.h5
--finp=hdf5; ../testdata/c6h6/ed.h5
#
# 2. labels of grid points
#    to find labels on the *.h5 file, you can do `h5dump -n FILE.h5`
#
--grid=[coor_1, coor_2, coor_3]
#
# 3. labels of grid functions
#
#--form_tensor_0order_3d=[/result/grid_function/j/visualize/values/t1_icomp_3]
--form_tensor_0order_3d=[t0_icomp_1]
#
# 4. what+how to calculate:
#
--calc_from_tensor_0order_3d=gradient
--calc_grad_method=numpy
#
# 5. apply basic filters from TTK; here: resample; this creates an image-data object
#
--resampled_dim=33,35,17
#
# 6. output:
#
--fout=csv; grad_ed.csv; cols=[x, y, z, t0:ed, t0_dx:ed_grad_x, t0_dy:ed_grad_y, t0_dz:ed_grad_z]
--fout=vti; grad_ed.vti; cols=[x, y, z, t0:ed, t0_dx:ed_grad_x, t0_dy:ed_grad_y, t0_dz:ed_grad_z]
--fout_select=all
--flog=result_log.txt
